import cv2
import os

### TO SAVE FRAMES
def frames_saved(video, path):

    video_frames = cv2.VideoCapture(video)
    cont = 0 

    ##enquanto o video estiver passsando
    while(video_frames.isOpened()) : 
        ret, frame = video_frames.read()

        if not ret:
            break

        if cont % 100 == 0:
            cv2.imwrite(os.path.join(path, f'{cont}.png'), frame)

        cont += 1
        
    cv2.destroyAllWindows()
    video_frames.release()

###chamando a funcao para salvar os frames do video
frames_saved('test_Video_rugby.mp4', 'Frames1')
