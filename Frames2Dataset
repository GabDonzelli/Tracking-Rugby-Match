### TO SAVE FRAMES
def frames_saved(video, path):
    video_frames = cv2.VideoCapture(video)

    cont = 0 
    ##enquanto o video estiver passsando
    
    while(video_frames.isOpened()) : 
        tilOver, frame = video.read()

        if not tilOver:
             break 
        
        if cont %100 == 0:
            cv2.imwrite(os.path.join(path, '%d.png' %cont), frame)
        
        cont+=1
           
    cv2.destroyAllWindows()
    video_frames.release()



